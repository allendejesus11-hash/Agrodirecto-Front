server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Mantener /api/v1 y los parametros al reenviar a Spring Boot.
    location /api/ {
        proxy_pass ${API_TARGET};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Angular Router: permitir abrir o recargar las rutas directamente.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Evitar que una version anterior de index.html quede en cache.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }
}
